#!/usr/bin/env python3
"""Single-process wrapper around the Bedrock dedicated server.

Runs hooks.d/pre.d, starts bedrock_server as a child, mirrors its console to
our own, forwards typed lines to its stdin, and handles "!" commands itself.
"""
import glob
import os
import signal
import subprocess
import sys
import threading
import time

DIR = os.path.dirname(os.path.abspath(__file__))
HOOKS = os.path.join(DIR, "hooks.d")
BACKUPS = os.path.join(DIR, "backups")
REAL = os.environ.get("BEDROCK_REAL", "")
INTERVAL = int(os.environ.get("BACKUP_INTERVAL", "3600"))
KEEP = int(os.environ.get("BACKUP_KEEP", "10"))
HOLD_TIMEOUT = float(os.environ.get("SAVE_HOLD_TIMEOUT", "10"))
SAVED_MARK = "files are now ready to be copied"

stdin_lock = threading.Lock()
op_lock = threading.Lock()
saved = threading.Event()
child = None
real = ""
restarting = False


def log(msg):
    print("[wrapper] " + msg, flush=True)


def find_real():
    if REAL:
        return REAL
    self_path = os.path.abspath(__file__)
    for name in ("bedrock_server.bin", "bedrock_server"):
        p = os.path.join(DIR, name)
        if os.path.isfile(p) and os.access(p, os.X_OK) and os.path.abspath(p) != self_path:
            return p
    return ""


def send(line):
    with stdin_lock:
        if child and child.poll() is None:
            try:
                child.stdin.write(line + "\n")
                child.stdin.flush()
            except (BrokenPipeError, ValueError):
                pass


def run_hooks(kind):
    env = os.environ.copy()
    env.update(BEDROCK_DIR=DIR, BEDROCK_REAL=real,
               BEDROCK_BACKUP_DIR=BACKUPS, BACKUP_KEEP=str(KEEP))
    for h in sorted(glob.glob(os.path.join(HOOKS, kind, "*"))):
        if not (os.path.isfile(h) and os.access(h, os.X_OK)):
            continue
        log("hook %s: %s" % (kind, os.path.basename(h)))
        rc = subprocess.call([h], cwd=DIR, env=env)
        if rc != 0:
            log("hook failed: %s (rc=%d)" % (h, rc))
            return rc
    return 0


def reader(proc):
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        if SAVED_MARK in line.lower():
            saved.set()
    rc = proc.wait()
    if proc is child and not restarting:
        log("server exited (rc=%d), shutting down" % rc)
        os._exit(rc if rc > 0 else 0)


def spawn():
    global child
    env = os.environ.copy()
    env["LD_LIBRARY_PATH"] = DIR + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    child = subprocess.Popen([real] + sys.argv[1:], cwd=DIR, env=env,
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True, bufsize=1)
    threading.Thread(target=reader, args=(child,), daemon=True).start()
    log("started %s (pid %d)" % (real, child.pid))


def stop_server(timeout=60):
    send("stop")
    try:
        child.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        log("server did not stop, killing it")
        child.kill()
        child.wait()


def backup(reason):
    if not op_lock.acquire(blocking=False):
        log("backup skipped (%s): another operation running" % reason)
        return
    try:
        if not child or child.poll() is not None:
            log("backup skipped (%s): server not running" % reason)
            return
        log("backup start (%s)" % reason)
        saved.clear()
        send("save hold")
        if not saved.wait(HOLD_TIMEOUT):
            log("warning: no save-hold confirmation, backing up anyway")
        rc = run_hooks("backup.d")
        send("save resume")
        log("backup done" if rc == 0 else "backup finished with errors (rc=%d)" % rc)
    finally:
        op_lock.release()


def restart(update):
    global restarting
    if not op_lock.acquire(blocking=False):
        log("restart skipped: another operation running")
        return
    try:
        if update and run_hooks("update.d") != 0:
            log("update failed, not restarting")
            return
        restarting = True
        log("restarting server")
        stop_server()
        spawn()
    finally:
        restarting = False
        op_lock.release()


def on_signal(signum, frame):
    log("signal %d, stopping" % signum)
    try:
        stop_server()
    finally:
        os._exit(0)


def main():
    global real
    real = find_real()
    if not real or not os.access(real, os.X_OK):
        log("real server not found (put bedrock_server.bin next to me or set BEDROCK_REAL)")
        return 127
    if run_hooks("pre.d") != 0:
        log("pre-start hook failed, aborting")
        return 1
    spawn()
    if INTERVAL > 0:
        threading.Thread(target=timer, daemon=True).start()
    try:
        for line in sys.stdin:
            cmd = line.strip()
            if not cmd:
                continue
            if not cmd.startswith("!"):
                send(cmd)
                continue
            word, _, _rest = cmd[1:].partition(" ")
            if word == "help":
                log("!backup !update !restart !stop; any other line goes to the server")
            elif word == "backup":
                backup("console")
            elif word == "update":
                restart(update=True)
            elif word == "restart":
                restart(update=False)
            elif word in ("stop", "quit"):
                stop_server()
                return child.returncode if child else 0
            else:
                log("unknown command: !%s (try !help)" % word)
    except KeyboardInterrupt:
        pass
    stop_server()
    return child.returncode if child else 0


def timer():
    while True:
        time.sleep(INTERVAL)
        backup("interval")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    sys.exit(main())
